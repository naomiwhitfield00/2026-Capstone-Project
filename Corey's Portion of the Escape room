"""
ESCAPE THE HOUSE
A text adventure: wake up, find your way out of the bedroom, get through the
hallway, and work out how to leave the house.

Run with:  python escape_room.py
"""

import random
import sys
import time

TEXT_DELAY = 0.008  # seconds per character. Set to 0 for instant text.


def say(text=""):
    """Print text with a small typing effect."""
    if TEXT_DELAY <= 0:
        print(text)
        return
    for ch in text:
        print(ch, end="", flush=True)
        time.sleep(TEXT_DELAY)
    print()


# Words that get ignored when reading a command ("look at the lamp" -> "look lamp")
FILLER = {"the", "a", "an", "at", "to", "my", "in", "into", "around", "through"}

LOOK_VERBS = {"look", "examine", "inspect", "check", "search", "l", "x", "view"}
TAKE_VERBS = {"take", "grab", "get", "pick", "collect"}
OPEN_VERBS = {"open", "turn", "unlock", "try", "push", "go", "walk", "enter", "leave", "exit"}
LAMP_VERBS = {"turn", "use", "switch", "light", "flip", "toggle"}

NUMBER_WORDS = {
    "1": 1, "one": 1, "first": 1, "1st": 1,
    "2": 2, "two": 2, "second": 2, "2nd": 2,
    "3": 3, "three": 3, "third": 3, "3rd": 3,
    "4": 4, "four": 4, "fourth": 4, "4th": 4,
    "5": 5, "five": 5, "fifth": 5, "5th": 5,
}

ITEM_NAMES = {
    "keys": "set of 5 keys",
    "hanger": "metal hanger",
    "notepad": "notepad",
    "pen": "pen",
}

PASSWORD = "Letsgetout123!"
BACK_DOOR_CODE = "253"

HELP_TEXT = """
Things you can try (these are examples, experiment!):
  look                     - describe where you are
  look <thing>             - examine something (look bed, look bookshelf...)
  open <thing>             - open a door, drawer, closet...
  take <item>              - pick something up
  use <item> on <thing>    - use something you're carrying
  go <place>               - move around (go hallway, go back, go bedroom)
  write <thing>            - write something on your notepad (needs pen + notepad)
  read notepad             - read your notes
  inventory                - see what you're carrying
  help                     - show this list
  quit                     - give up
"""


def has(text, *keys):
    """True if any of the keys appears in the text."""
    return any(k in text for k in keys)


def door_number(rest):
    for word in rest.split():
        if word in NUMBER_WORDS:
            return NUMBER_WORDS[word]
    return None


class Game:
    def __init__(self):
        self.loc = "bedroom"
        self.inv = []
        self.cents = 0
        self.notes = []

        # Bedroom state
        self.lamp_on = False
        self.bed_made = False
        self.drawer_open = False
        self.closet_open = False

        # Hallway state (one random door out of five takes the keys)
        self.good_door = random.randint(1, 5)
        self.hall_door_unlocked = False

        # Living room state
        self.couch_searched = False
        self.recliner_searched = False
        self.page_seen = False
        self.pw_seen = False
        self.logged_in = False

        self.won = False

    # ------------------------------------------------------------------
    # Room descriptions
    # ------------------------------------------------------------------

    def describe(self):
        getattr(self, f"describe_{self.loc}")()

    def describe_bedroom(self):
        if self.lamp_on:
            say("A warm glow from the lamp lights up a small bedroom.")
        else:
            say("You are in a dimly lit bedroom.")
        if self.bed_made:
            say("The bed is neatly made.")
        else:
            say("The bed looks like it has been slept in.")
        say("A night stand with a lamp sits beside it.")
        if self.closet_open:
            say("The closet door is open, showing a row of ordinary clothes.")
        else:
            say("A closet door is barely open.")
        say("The main door out of the room is across from the bed.")

    def describe_hallway(self):
        say("A long hallway stretches out in front of you. The lights flicker, "
            "throwing shadows up and down the walls.")
        if self.hall_door_unlocked:
            say(f"There are five doors. Door {self.good_door} is unlocked and stands ready to open.")
        else:
            say("There are five doors along the hall, numbered 1 to 5.")
        say("Behind you is the bedroom.")

    def describe_living_room(self):
        say("A living room. A couch and a recliner face a bookshelf against one wall.")
        say("On the far side of the room is a desk with a monitor, keyboard, mouse, "
            "mousepad, and a notepad with a pen.")
        say("There are two doors: a front door that is completely boarded up, "
            "and a back door with a small keypad.")
        say("The hallway is behind you.")

    # ------------------------------------------------------------------
    # Command handling
    # ------------------------------------------------------------------

    def handle(self, raw):
        words = [w for w in raw.lower().split() if w not in FILLER]
        if not words:
            return
        verb, rest = words[0], " ".join(words[1:])

        # Global commands
        if verb in ("help", "h", "?"):
            print(HELP_TEXT)
            return
        if verb in ("inventory", "inv", "i"):
            self.show_inventory()
            return
        if verb in ("quit", "q"):
            say("You curl up on the floor and give up. Game over.")
            sys.exit()
        if verb == "read" and has(rest, "notepad", "notes", "pad"):
            self.read_notepad()
            return
        if verb == "write":
            self.write(rest)
            return
        if verb in LOOK_VERBS and not rest:
            self.describe()
            return

        getattr(self, f"do_{self.loc}")(verb, rest)

    def show_inventory(self):
        items = [ITEM_NAMES[i] for i in self.inv]
        if self.cents:
            items.append(f"${self.cents / 100:.2f} in loose change")
        say("You are carrying: " + (", ".join(items) if items else "nothing") + ".")

    def read_notepad(self):
        if "notepad" not in self.inv:
            say("You don't have a notepad.")
        elif not self.notes:
            say("The notepad is blank.")
        else:
            say("Your notepad says:")
            for note in self.notes:
                say(f"  - {note}")

    def write(self, rest):
        if "notepad" not in self.inv or "pen" not in self.inv:
            say("You need both a notepad and a pen to write anything down.")
            return
        if has(rest, "password", "pass"):
            if not self.pw_seen:
                say("You don't have a password to write down yet.")
                return
            note = f"Password: {PASSWORD}"
        elif has(rest, "page", "253", "code", "number", "bookmark"):
            if not self.page_seen:
                say("You haven't found a page number to write down yet.")
                return
            note = "War of the Worlds bookmark: page 253"
        else:
            say("Write what? Try 'write password' or 'write page number'.")
            return
        if note in self.notes:
            say("You've already written that down.")
        else:
            self.notes.append(note)
            say(f"You jot down: {note}")

    # ------------------------------------------------------------------
    # Bedroom
    # ------------------------------------------------------------------

    def do_bedroom(self, verb, rest):
        # Lamp
        if verb in LAMP_VERBS and has(rest, "lamp", "light"):
            self.lamp_on = not self.lamp_on
            say("The lamp clicks on. Warm light fills the room." if self.lamp_on
                else "The lamp clicks off. The room falls dim again.")
            return
        if verb in LOOK_VERBS and has(rest, "lamp"):
            say("A simple bedside lamp. It's currently " + ("on." if self.lamp_on else "off."))
            return

        # Bed
        if verb == "make" and has(rest, "bed"):
            if self.bed_made:
                say("The bed is already made.")
            else:
                self.bed_made = True
                say("You straighten the sheets and fluff the pillow. Nothing hidden "
                    "in there, but at least it looks tidy.")
            return
        if verb in LOOK_VERBS and has(rest, "bed", "pillow", "sheet"):
            say("A neatly made bed." if self.bed_made else
                "The sheets are rumpled and the pillow is dented. Someone slept here recently. "
                "Maybe you? You could try to 'make bed'.")
            return

        # Closet
        if has(rest, "closet") and (verb in LOOK_VERBS or verb in OPEN_VERBS):
            if not self.closet_open:
                self.closet_open = True
                say("You pull the closet door open. Just ordinary clothes on a rail... "
                    "and a metal hanger dangling at the end.")
            elif "hanger" in self.inv:
                say("Just ordinary clothes.")
            else:
                say("Just ordinary clothes, and a metal hanger dangling at the end.")
            return

        # Night stand / drawer
        if has(rest, "drawer", "nightstand", "stand", "table") and (
                verb in LOOK_VERBS or verb in OPEN_VERBS):
            self.drawer_open = True
            if "keys" in self.inv:
                say("The drawer is empty now.")
            else:
                say("You slide open the drawer and find a set of keys. About five of them on a ring.")
            return

        # Taking things
        if verb in TAKE_VERBS:
            if has(rest, "key"):
                if "keys" in self.inv:
                    say("You already have the keys.")
                elif self.drawer_open:
                    self.inv.append("keys")
                    say("You take the ring of keys. Five of them, all different.")
                else:
                    say("You don't see any keys. Maybe check the night stand.")
            elif has(rest, "hanger"):
                if "hanger" in self.inv:
                    say("You already have the hanger.")
                elif self.closet_open:
                    self.inv.append("hanger")
                    say("You unhook the metal hanger from the closet rail.")
                else:
                    say("You don't see a hanger. The closet door is barely open, though.")
            else:
                say("You can't take that.")
            return

        # Door out
        if verb in ("leave", "exit") or (
                verb in OPEN_VERBS and has(rest, "knob", "door", "out", "hall")):
            say("You turn the knob and step out of the bedroom.")
            self.loc = "hallway"
            self.describe()
            return
        if verb in LOOK_VERBS and has(rest, "door"):
            say("A plain wooden door. The knob turns freely.")
            return

        say("You're not sure how to do that.")

    # ------------------------------------------------------------------
    # Hallway
    # ------------------------------------------------------------------

    def do_hallway(self, verb, rest):
        if verb in ("go", "walk", "enter", "leave", "exit") and has(rest, "bedroom", "back"):
            self.loc = "bedroom"
            say("You head back into the bedroom.")
            self.describe()
            return

        num = door_number(rest)

        if verb in LOOK_VERBS and has(rest, "door"):
            if num:
                say(f"Door {num}: plain wood with a brass keyhole.")
            else:
                say("Five doors, all similar: plain wood with brass keyholes.")
            return

        if has(rest, "door", "living", "room") or num:
            if verb in TAKE_VERBS:
                say("You can't take that.")
                return
            if num is None:
                if self.hall_door_unlocked:
                    num = self.good_door
                else:
                    say("Which door? Try 'open door 1' through 'open door 5'.")
                    return
            self.try_door(num)
            return

        say("You're not sure how to do that.")

    def try_door(self, num):
        if num == self.good_door:
            if self.hall_door_unlocked:
                say("You open the unlocked door and walk in.")
            elif "keys" in self.inv:
                say(f"You try the keys one by one on door {num}... the fourth one turns with a click!")
                self.hall_door_unlocked = True
            else:
                say(f"Door {num} is locked. You need a key.")
                return
            self.loc = "living_room"
            self.describe()
        else:
            if "keys" in self.inv:
                say(f"You try every key on door {num}. None of them fit, and the door doesn't "
                    "budge. It feels like there's solid wall behind it.")
            else:
                say(f"Door {num} is locked and doesn't budge.")

    # ------------------------------------------------------------------
    # Living room
    # ------------------------------------------------------------------

    def do_living_room(self, verb, rest):
        looking = verb in LOOK_VERBS
        taking = verb in TAKE_VERBS

        # Back door with the keypad
        if has(rest, "back door", "keypad", "code", "other door", "second door"):
            if looking:
                say("A sturdy door with a keypad beside it. It wants a 3-digit code.")
            else:
                self.enter_code()
            return

        # Front door
        if has(rest, "front"):
            if verb == "use" and has(rest, "hanger"):
                if "hanger" not in self.inv:
                    say("You don't have a hanger.")
                else:
                    say("You bend the hanger and hook it around the edge of a board, "
                        "prying it back just enough to peek through the gap.")
                    say("Darkness outside. Something shifts out there. Something that "
                        "doesn't want to be seen. You let the board slap back into place.")
            else:
                say("The front door is boarded up tightly with planks and nails. "
                    "Are we keeping something from coming in?")
            return

        # Leaving via hallway
        if verb in ("go", "walk", "leave", "exit") and has(rest, "hall", "back", "bedroom"):
            self.loc = "hallway"
            say("You step back into the flickering hallway.")
            self.describe()
            return

        # Couch and recliner
        if has(rest, "couch", "sofa", "recliner", "chair", "cushion"):
            if has(rest, "recliner", "chair"):
                self.search_seat("recliner")
            elif has(rest, "couch", "sofa"):
                self.search_seat("couch")
            else:
                say("Which one, the couch or the recliner?")
            return

        # Bookshelf and the book
        is_shelf = has(rest, "shelf", "books")
        is_book = has(rest, "war", "worlds", "novel") or (has(rest, "book") and not is_shelf)
        if is_book:
            self.inspect_book()
            return
        if is_shelf:
            say("Numerous books line the shelf, but one really stands out: "
                "'War of the Worlds'.")
            return

        # Desk area
        if has(rest, "keyboard"):
            if has(rest, "under", "beneath"):
                self.pw_seen = True
                say(f"You lift the keyboard. A sticky note reads: \"{PASSWORD}\"")
                say("That looks like a password. Maybe write it down.")
            else:
                say("A regular keyboard. Something might be hidden under it.")
            return
        if has(rest, "monitor", "computer", "screen", "login", "log") or verb in ("login", "log", "type"):
            self.computer(looking)
            return
        if has(rest, "mousepad"):
            say("A plain mousepad. Nothing under it.")
            return
        if has(rest, "mouse"):
            say("An ordinary computer mouse.")
            return
        if has(rest, "notepad", "note", "pad"):
            self.take_desk_item("notepad", taking, "a notepad")
            return
        if has(rest, "pen"):
            self.take_desk_item("pen", taking, "a pen")
            return
        if has(rest, "desk"):
            say("On the desk: a monitor, keyboard, mouse, mousepad, and a notepad with a pen.")
            return

        say("You're not sure how to do that.")

    def search_seat(self, seat):
        if seat == "couch":
            if self.couch_searched:
                say("You've already searched the couch cushions.")
            else:
                self.couch_searched = True
                self.cents += 75
                say("You dig between the couch cushions and pull out 75 cents.")
        else:
            if self.recliner_searched:
                say("You've already searched the recliner.")
            else:
                self.recliner_searched = True
                self.cents += 125
                say("You feel around the recliner cushions and pull out $1.25.")

    def inspect_book(self):
        self.page_seen = True
        say("You pull 'War of the Worlds' off the shelf. A bookmark sticks out of it, "
            "marking page 253.")
        say("Worth writing down.")

    def take_desk_item(self, item, taking, label):
        if item in self.inv:
            say(f"You already have {label}.")
        elif taking:
            self.inv.append(item)
            say(f"You pick up {label}.")
        else:
            say(f"{label.capitalize()} sits on the desk. You could take it.")

    def computer(self, just_looking):
        if self.logged_in:
            say("The screen shows an open text file called READ_ME.txt:")
            self.show_readme()
            return
        say("The monitor glows with a login screen. It's asking for a password.")
        if just_looking:
            return
        guess = input("Password: ").strip()
        if guess == PASSWORD:
            self.logged_in = True
            say("Access granted. A single file sits on the desktop: READ_ME.txt")
            self.show_readme()
        else:
            say("Access denied.")

    def show_readme(self):
        say("  \"If you're reading this, you woke up again.\"")
        say("  \"Do NOT open the front door. Leave through the back.\"")
        say("  \"The keypad code is the last page I was reading.\"")

    def enter_code(self):
        code = input("Enter the 3-digit code: ").strip()
        if code == BACK_DOOR_CODE:
            say("The keypad blinks green. The lock releases with a heavy thunk.")
            say("")
            say("You push the back door open. Cool night air rushes in.")
            say("Behind you, something slams against the boarded front door.")
            say("You don't look back. You run.")
            say("")
            say("*** YOU ESCAPED! ***")
            self.won = True
        else:
            say("The keypad flashes red. Wrong code.")


def main():
    game = Game()

    say("=" * 50)
    say("                ESCAPE THE HOUSE")
    say("=" * 50)
    say("")
    say("You wake up with no memory of how you got here.")
    say("Type 'help' to see what you can do.")
    say("")
    game.describe()

    while not game.won:
        try:
            command = input("\n> ")
        except (EOFError, KeyboardInterrupt):
            print()
            break
        game.handle(command)


if __name__ == "__main__":
    main()
